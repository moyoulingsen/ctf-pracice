service ctf
{
    disable     = no
    socket_type = stream
    protocol    = tcp
    wait        = no
    user        = ctf
    type        = UNLISTED
    port        = 9999
    bind        = 0.0.0.0
    server      = /home/ctf/service.sh
    banner_fail = /etc/banner_fail
    # safety options
    per_source  = 10
    rlimit_cpu  = 20
}
